# EmailJS — used by the contact form (components/contact/contact-form.tsx).
# These are EmailJS's public identifiers (service/template ID + public key), safe to expose
# client-side by design — there is no secret/private key here.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Resume link — used by the Resume button (components/shared/resume-button.tsx).
# A Google Drive share link ("Anyone with the link" viewer access). Optional: falls back to
# the current resume link in lib/content/site.ts if unset. Set/override in Netlify's env vars
# to swap resumes without a code change (redeploy required to pick it up).
NEXT_PUBLIC_RESUME_URL=
