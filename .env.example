# EmailJS — used by the contact form (components/contact/contact-form.tsx).
# These are EmailJS's public identifiers (service/template ID + public key), safe to expose
# client-side by design — there is no secret/private key here.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
